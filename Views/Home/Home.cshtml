@model List<TP07.Models.Publicaciones>

<div class="home-page">
    <div class="home-header">
        <div class="home-welcome">
            <h1>Bienvenido, @ViewBag.UsuarioNombre</h1>
            <h3>Recuerde cerrar sesión al finalizar su actividad.</h3>
        </div>

        <div class="home-actions">
            <form action='@Url.Action("Publicar", "Home")' method="get">
                <button type="submit" class="btn btn-primary">Agregar Publicación</button>
            </form>

            <form action='@Url.Action("Logout", "Home")' method="get">
                <button type="submit" class="btn btn-secondary">Cerrar Sesión</button>
            </form>
        </div>
    </div>

    <div class="home-feed">
        @{ 
            int cantidadInicialPublicaciones = ViewBag.CantidadInicialPublicaciones != null ? (int)ViewBag.CantidadInicialPublicaciones : 0;
            bool hayMasPublicaciones = ViewBag.HayMasPublicaciones != null ? (bool)ViewBag.HayMasPublicaciones : false;
        }

        <div id="publicaciones-container" data-cantidad-inicial="@cantidadInicialPublicaciones">
        @if (Model != null && Model.Any())
        {
            var nombresUsuarios = ViewBag.NombresUsuarios as Dictionary<int, string>;
            var likesPorPublicacion = ViewBag.LikesPorPublicacion as Dictionary<int, int>;
            var publicacionesConLikeDelUsuario = ViewBag.PublicacionesConLikeDelUsuario as HashSet<int>;

            foreach (var publicacion in Model)
            {
                var srcImagen = string.IsNullOrWhiteSpace(publicacion.Imagen)
                    ? null
                    : (publicacion.Imagen.StartsWith("/") ? publicacion.Imagen : Url.Content($"~/imagenes/{publicacion.Imagen}"));
                var nombreUsuario = nombresUsuarios != null && nombresUsuarios.ContainsKey(publicacion.IdUsuario)
                    ? nombresUsuarios[publicacion.IdUsuario]
                    : "Usuario desconocido";
                var likesActuales = likesPorPublicacion != null && likesPorPublicacion.ContainsKey(publicacion.Id)
                    ? likesPorPublicacion[publicacion.Id]
                    : 0;
                var usuarioDioLike = publicacionesConLikeDelUsuario != null && publicacionesConLikeDelUsuario.Contains(publicacion.Id);

                <article class="post-card">
                    <div class="post-body">
                        <div class="post-username">@nombreUsuario</div>
                        <div class="post-title">@publicacion.Titulo</div>
                        <div class="post-date">@publicacion.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(srcImagen))
                    {
                        <div class="post-image-wrap">
                            <img class="post-image" src="@srcImagen" alt="@publicacion.Titulo" />
                        </div>
                    }

                    <div class="post-description">
                        @publicacion.Descripcion
                    </div>

                    <div class="post-actions">
                        <button id="btn-like-@publicacion.Id" onclick="toggleLike(@publicacion.Id)" class="btn btn-like">@(usuarioDioLike ? "Ya no me gusta" : "Me gusta")</button>
                        <span id="likes-count-@publicacion.Id">@likesActuales Me gusta</span>
                        <form action='@Url.Action("Comentar", "Home")' method="get">
                            <button type="submit" onclick="comentar(@publicacion.Id)" class="btn btn-comment">Comentar</button>
                            <input type="text" name="comentario" placeholder="Escribe un comentario..." required />
                            <input type="hidden" name="idPublicacion" value="@publicacion.Id" />
                        </form>
                    </div>

                    <div class="comentarios">
                        <button onclick="getComentarios(@publicacion.Id)" class="btn btn-comment">Ver Comentarios</button>
                        <h2 id="comentario-@publicacion.Id"></h2>
                    </div>
                </article>
            }
        }
        else
        {
            <div class="home-empty-state">
                No hay publicaciones para mostrar.
            </div>
        }
        </div>

        <div style="margin-top: 16px;">
            <button id="btn-ver-mas" type="button" onclick="cargarMasPublicaciones()" class="btn btn-primary" style="display:@(hayMasPublicaciones ? "inline-block" : "none")">Ver más</button>
        </div>
    </div>
</div>
