@{
	ViewData["Title"] = "Home Page";
	ViewBag.LayoutBodyClass = "index-page";
}

<div class="index-hero">
	<div class="index-card">
		<div class="index-visual">
			<div class="welcome">
				<h1>Bienvenido a la red</h1>
				<p>Conecta con amigos, comparte momentos y descubre contenido nuevo cada día.</p>
			</div>
		</div>
		<div class="index-actions">
			<h2>Inicia sesión</h2>
			<p>Accede con tu cuenta para ver y crear publicaciones.</p>
			<div class="index-cta-row">
				<form action='@Url.Action("Login", "Home")' method="get" style="margin:0;">
					<button type="submit" class="btn-modern">Iniciar Sesión</button>
				</form>
				<form action='@Url.Action("Registro", "Home")' method="get" style="margin:0;">
					<button type="submit" class="btn-ghost">Registrarse</button>
				</form>
			</div>
		</div>
	</div>
</div>
