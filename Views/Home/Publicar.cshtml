@{
	ViewData["Title"] = "Publicar";
}

<div class="container" style="max-width: 720px; margin: 0 auto;">
	<h1>Nueva publicación</h1>

	<form action='@Url.Action("AgregarPublicacion", "Home")' method="post" enctype="multipart/form-data">
		<div class="form-group" style="margin-bottom: 1rem;">
			<label for="imagen">Imagen</label>
			<input type="file" id="imagen" name="Imagen" accept="image/*" class="form-control" required />
		</div>

		<div class="form-group" style="margin-bottom: 1rem;">
			<label for="titulo">Título</label>
			<input type="text" id="titulo" name="Titulo" class="form-control" required />
		</div>

		<div class="form-group" style="margin-bottom: 1rem;">
			<label for="descripcion">Descripción</label>
			<textarea id="descripcion" name="Descripcion" rows="5" class="form-control" required></textarea>
		</div>

		<div class="form-group" style="margin-bottom: 1rem;">
			<label for="usuario">Usuario que realizó la publicación</label>
			<input type="text" id="usuario" class="form-control" value="@ViewBag.UsuarioNombre" readonly />
			<input type="hidden" name="IdUsuario" value="@Context.Session.GetString("ID")" />
		</div>

		<button type="submit" class="btn btn-primary">Publicar</button>
		<a class="btn btn-secondary" href='@Url.Action("Home", "Home")'>Cancelar</a>
	</form>
</div>
